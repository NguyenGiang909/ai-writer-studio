{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Writer Studio",
  "version": "0.1.0",
  "identifier": "com.aiwriter.studio",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Writer Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "../writer-api.exe",
      "../node.exe",
      "../web"
    ],
    "category": "Productivity",
    "shortDescription": "Story OS cho tieu thuyet dai ky",
    "longDescription": "AI Writer Studio - khong gian viet tieu thuyet dai ky: tac gia viet truoc, AI ho tro thao luan, mo rong va kiem tra tinh lien tuc.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
